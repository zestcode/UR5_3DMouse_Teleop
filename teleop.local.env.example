# Machine settings for teleop.sh. Copy to teleop.local.env (not committed) and fill in.
# KEY=value, one per line; variables already set in the shell take precedence.

# UR5 controller address (RTDE + Robotiq URCap socket :63352)
ROBOT_IP=<robot-ip>
# role:librealsense-serial, comma separated (rs-enumerate-devices -s lists the serials)
CAMERAS=wrist:<wrist-serial>,fixed:<fixed-serial>
# Python env with requirements.txt installed (its bin/ goes on PATH); leave empty if dora/python are already on PATH
TELEOP_VENV=<path-to-venv>
# Optional: where sessions are written (default: data/ next to teleop.sh)
# OUT_DIR=
# Optional, deploy.sh (VPP policy server; defaults shown): where it runs (local = this machine's GPU, an ssh host
# such as pegasus, or '' = already running at POLICY_ADDR), the VPP code + model files there and the python of its
# conda env vpp (ssh defaults: /mnt/raptor/kim/AtomicVPP_LIBERO, ~/miniconda3/envs/vpp/bin/python), the server
# port, and the checkpoint / weights it serves when deploy.sh starts it
# VPP_HOST=local
# VPP_REPO=<the folder that holds teleop/>/vpp
# VPP_PYTHON=<conda base>/envs/vpp/bin/python
# VPP_PORT=47110
# VPP_CKPT=ur5_dp/checkpoints/last.pt
# VPP_WEIGHTS=ema
