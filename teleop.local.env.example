# Machine settings for teleop.sh. Copy to teleop.local.env (not committed) and fill in.
# KEY=value, one per line; variables already set in the shell take precedence.

# UR5 controller address (RTDE + Robotiq URCap socket :63352)
ROBOT_IP=<robot-ip>
# role:librealsense-serial, comma separated (rs-enumerate-devices -s lists the serials)
CAMERAS=wrist:<wrist-serial>,fixed:<fixed-serial>
# Python env with requirements.txt installed (its bin/ goes on PATH); leave empty if dora/python are already on PATH
TELEOP_VENV=<path-to-venv>
# Optional: where sessions are written (default: data/ next to teleop.sh)
# OUT_DIR=
